{
  "name": "workday-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:extension": "pnpm --filter extension dev",
    "build:extension": "pnpm --filter extension build",
    "test:backend": "pnpm --filter backend test",
    "test:extension": "pnpm --filter extension test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7"
  },
  "lint-staged": {
    "apps/backend/src/**/*.ts": [
      "pnpm --filter backend exec prettier --write",
      "pnpm --filter backend exec eslint --fix"
    ],
    "apps/extension/src/**/*.{ts,tsx}": [
      "pnpm --filter extension exec prettier --write",
      "pnpm --filter extension exec eslint --fix"
    ],
    "packages/**/*.ts": [
      "pnpm --filter backend exec prettier --write"
    ]
  }
}
