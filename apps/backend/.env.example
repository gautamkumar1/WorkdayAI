# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the main database
# Create with: createdb workday_ai
DATABASE_URL="postgresql://postgres:password@localhost:5432/workday_ai"

# Separate database used only during test runs (never the main DB)
# Create with: createdb workday_ai_test
DATABASE_URL_TEST="postgresql://postgres:password@localhost:5432/workday_ai_test"

# ─── Authentication ─────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens — use a long random string (min 32 chars)
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-secret"

# How long issued JWTs stay valid
JWT_EXPIRES_IN="7d"

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Your OpenAI API key — never commit this, never log it, never send it to the extension
OPENAI_API_KEY="sk-..."

# Primary model for resume parsing, field mapping, and answer generation
# Default: gpt-4o (best accuracy). Change to gpt-4o-mini to reduce cost.
OPENAI_MODEL="gpt-4o"

# Fallback model used for cost-sensitive operations
OPENAI_FALLBACK_MODEL="gpt-4o-mini"

# Maximum tokens per OpenAI request (guards against runaway costs)
OPENAI_MAX_TOKENS=4096

# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Express API listens on
PORT=3000

# Node environment — controls logging verbosity and error detail in responses
NODE_ENV="development"

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Chrome extension origin — update with your actual extension ID after loading it in Chrome
# Find it at chrome://extensions after clicking "Load unpacked"
# Format: chrome-extension://<extension-id>
EXTENSION_ORIGIN="chrome-extension://your-extension-id"
