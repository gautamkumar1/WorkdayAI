{
  "manifest_version": 3,
  "name": "WorkdayAI",
  "version": "1.0.0",
  "description": "AI-powered Workday job application autofill",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.myworkdayjobs.com/*"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "WorkdayAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.myworkdayjobs.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
